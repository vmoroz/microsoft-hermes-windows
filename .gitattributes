# Force LF line endings for test files. Test assertions contain hard-coded
# byte offsets and string values that assume LF line endings.
test/**/*.js text eol=lf
test/**/*.js.txt text eol=lf
test/**/*.sh text eol=lf

# Generated wasm2c output of the sandboxed VM (see API/hermes_sandbox/README.md).
# Each upstream sync regenerates these ~200 MB; treat them as binary so diffs
# and pull requests stay reviewable.
API/hermes_sandbox/external/hermes_sandbox_impl_*_compiled* -diff linguist-generated